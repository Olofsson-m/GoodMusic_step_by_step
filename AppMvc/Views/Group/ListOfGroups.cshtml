@model ListOfGroups   //typed ViewModel
@{
    ViewData["Title"] = "List groups";
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!-- Page List of groups -->
<div class="container px-4 py-4" id="list-of-groups">
    <h2 class="pb-2 border-bottom">List of Music bands</h2>

    <p>Below are some of the worlds most famous Music bands.</p>
    <p>The database contains @Model.NrOfGroups music groups the search criteria</p>

    <form method="post" class="needs-validation" novalidate>
        <label class="form-check-label" for="useSeeds"></label>
        <input asp-for="UseSeeds" class="form-check-input" type="checkbox" id="useSeeds">
        Use seeded data
        <div class="row row-cols-1 row-cols-lg-4 align-items-stretch g-4 py-5">
            <div class="col-md-7 col-lg-10">
                <div class="row mb-2 text-center">
                    <!-- Search filter-->
                    <div class="row mb-1 text-center">
                        <div class="col-md-6 ">
                            <input asp-for="SearchFilter" class="form-control" type="search" placeholder="Search" aria-label="Search">
                        </div>
                        <div class="col-md-2 ">
                            <button asp-controller="Group" asp-action="SearchGroup" class="btn btn-outline-success" type="submit">Search</button>
                        </div>
                    </div>
                </div>
                <div class="row mb-2 text-center">
                    <!-- This is where selected item id will be stored -->
                    <input type="hidden" name="groupId" data-seido-selected-item-id-target />

                    <div class="col-md-12 themed-grid-head-col">Group Name</div>
                </div>

                <div class="row mb-2 text-center">

                    @if (Model.MusicGroups is not null)
                    {
                        @foreach (var item in Model.MusicGroups)
                        {
                            <div class="col-md-12 themed-grid-col">
                                <a asp-controller="Group" asp-action="ViewGroup" asp-route-id="@item.MusicGroupId">
                                    @item.Name
                                </a>
                            </div>
                        }
                        <nav aria-label="Standard pagination example">
                            <ul class="pagination">
                                <li class="page-item">
                                    <a class="page-link" asp-controller="Group" asp-action="ListOfGroups" asp-route-pagenr="@Model.PrevPageNr" asp-route-search="@Model.SearchFilter" aria-label="Previous">
                                        <span aria-hidden="true">&laquo;</span>
                                    </a>
                                </li>
                                @for (int i = 0; i < Model.NrVisiblePages; i++)
                                {
                                    <li class="page-item">
                                        <a class="page-link" asp-controller="Group" asp-action="ListOfGroups" asp-route-pagenr="@i" asp-route-search="@Model.SearchFilter">@(i + 1)</a>
                                    </li>

                                }
                                <li class="page-item">
                                    <a class="page-link" asp-controller="Group" asp-action="ListOfGroups" asp-route-pagenr="@Model.NextPageNr" asp-route-search="@Model.SearchFilter" aria-label="Next">
                                        <span aria-hidden="true">&raquo;</span>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    }
                </div>
            </div>
        </div>
    </form>
</div>


